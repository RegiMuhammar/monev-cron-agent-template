# Kredensial akun SIAPkerja / Kemnaker untuk login Monev
MONEV_EMAIL=email_kamu@example.com
MONEV_PASSWORD=password_kamu
NOTIFY_EMAIL=email_penerima@gmail.com

# Opsional: Playwright storage_state JSON (atau base64) agar GitHub Actions skip login SSO
# MONEV_STORAGE_STATE={"cookies":[...],"origins":[...]}

# Opsi 1 (Rekomendasi): Resend API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Jika belum verifikasi domain sendiri, biarkan default onboarding@resend.dev
# (dengan onboarding@resend.dev, NOTIFY_EMAIL harus sama dengan email akun Resend kamu)
RESEND_FROM=Monev Bot <onboarding@resend.dev>

# Opsi 2 (Alternatif): SMTP (jika tidak mengisi RESEND_API_KEY)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=email_pengirim@gmail.com
# SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Opsional
HEADLESS=true
DRY_RUN=false
